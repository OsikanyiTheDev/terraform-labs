########################################
# TERRAFORM CORE
########################################

.terraform/
*.tfstate
*.tfstate.*
terraform.tfstate
terraform.tfstate.backup
crash.log

# Terraform CLI configs
.terraform.lock.hcl
.terraformrc
terraform.rc

# Override files (rare but possible)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

########################################
# TERRAFORM VARIABLES (SENSITIVE)
########################################

*.tfvars
*.tfvars.json
terraform.tfvars

# Allow example files (safe to commit)
!terraform.tfvars.example

########################################
# AWS / CLOUD CREDENTIALS
########################################

*.pem
*.key
*.p12
*.crt

# AWS CLI credentials (if accidentally inside repo)
.aws/
credentials
config

########################################
# SSH KEYS (LABS)
########################################

lab*-key*
key-*
*.pub

########################################
# LOCAL ENVIRONMENTS
########################################

.env
.env.*
venv/
__pycache__/

########################################
# IDE / EDITORS
########################################

.vscode/
.idea/
*.swp
*.swo

########################################
# OS FILES
########################################

.DS_Store
Thumbs.db

########################################
# LOGS
########################################

*.log
logs/

########################################
# BACKUPS (TERRAFORM / SYSTEM)
########################################

*.backup